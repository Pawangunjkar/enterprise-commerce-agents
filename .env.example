# Commerce suite (gateway preferred so one URL reaches every domain)
ECS_GATEWAY_URL=http://localhost:8080
ECS_SERVICE_URL=http://localhost:8080
ECS_TENANT_ID=default
ECS_BEARER_TOKEN=
ECS_HTTP_TIMEOUT=20

# Sibling MCP package must be installed: pip install -e ../enterprise-commerce-mcps
# Optional override if the MCP venv python differs from this project's interpreter
ECS_MCP_PYTHON=

# LLM for LangGraph ReAct (optional — named scenarios run without an LLM)
# auto = OpenAI if OPENAI_API_KEY is set, otherwise Gemini if GEMINI_API_KEY / GOOGLE_API_KEY is set
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
